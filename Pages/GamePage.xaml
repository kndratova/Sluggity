<Page x:Class="Sluggity.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:viewModels="clr-namespace:Sluggity.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance viewModels:GameHudViewModel}"
      Title="GamePage">

    <Page.Resources>
        <Storyboard x:Key="ToastAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="DeathAnimation">
            <DoubleAnimation Storyboard.TargetName="DeathFlash" Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0" Duration="0:0:0.5" />
        </Storyboard>

        <Style x:Key="HudPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="PowerUpIcon" TargetType="Image">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
    </Page.Resources>

    <Grid ClipToBounds="True" Background="{StaticResource DeepBrush}">
        <Canvas>
            <Image x:Name="BackgroundImage" Source="/Sprites/background.png" Width="1400" Height="900"
                   Stretch="UniformToFill" />
        </Canvas>

        <Canvas x:Name="GameCanvas">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="CameraTransform" />
            </Canvas.RenderTransform>
        </Canvas>

        <Grid Margin="16">
            <Border Style="{StaticResource HudPanel}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding PearlIcon}" Width="32" Height="25" Margin="0,0,10,0" />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="22">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="PearlsCollected" />
                                <Binding Path="PearlsTotal" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HudPanel}" HorizontalAlignment="Center">
                <TextBlock Text="{Binding LevelTitle}" Style="{StaticResource BodyText}" FontSize="22" />
            </Border>

            <Border Style="{StaticResource HudPanel}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding KnifeIcon}" ToolTip="Knife">
                        <Image.Style>
                            <Style TargetType="Image" BasedOn="{StaticResource PowerUpIcon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasKnife}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Source="{Binding LegsIcon}" ToolTip="Legs">
                        <Image.Style>
                            <Style TargetType="Image" BasedOn="{StaticResource PowerUpIcon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLegs}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </StackPanel>
            </Border>

            <TextBlock Text="← →  move     ↑ / space  jump     esc  pause     r  restart"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}" Style="{StaticResource BodyText}" />
        </Grid>

        <Border x:Name="Toast" Style="{StaticResource HudPanel}" Opacity="0" Margin="0,90,0,0"
                HorizontalAlignment="Center" Padding="24,12" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" FontSize="24" />
        </Border>

        <Rectangle x:Name="DeathFlash" Fill="#FFE0445A" Opacity="0" IsHitTestVisible="False" />

        <Grid Style="{StaticResource Overlay}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource OverlayPanel}">
                <StackPanel>
                    <TextBlock Text="Paused" FontSize="72" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <Button Content="Resume" Style="{StaticResource SmallMenuButton}" Click="ResumeButton_Click" />
                    <Button Content="Restart" Style="{StaticResource SmallMenuButton}" Click="RestartButton_Click" />
                    <Button Content="Levels" Style="{StaticResource SmallMenuButton}" Click="LevelsButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Style="{StaticResource Overlay}" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource OverlayPanel}">
                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="64" Style="{StaticResource TitleText}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,20">
                        <Image Source="{Binding PearlIcon}" Width="40" Height="31" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource BodyText}" FontSize="28" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1} pearls">
                                    <Binding Path="PearlsCollected" />
                                    <Binding Path="PearlsTotal" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <Button Content="Next level" Style="{StaticResource SmallMenuButton}" Click="NextLevelButton_Click"
                            Visibility="{Binding HasNextLevel, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Replay" Style="{StaticResource SmallMenuButton}" Click="RestartButton_Click" />
                    <Button Content="Levels" Style="{StaticResource SmallMenuButton}" Click="LevelsButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
