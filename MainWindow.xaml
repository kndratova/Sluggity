<Window x:Class="Sluggity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sluggity"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Viewbox x:Name="RootViewbox" Width="800" Height="600" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Frame x:Name="MainFrame"
               Width="800"
               Height="600"
               NavigationUIVisibility="Hidden"
               Focusable="False"
               ClipToBounds="True" />
    </Viewbox>
</Window>