<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sluggity</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Sprites\*.png" />
    <Resource Include="Fonts\**\*.ttf" />
    <Content Include="Scenes\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
