<Page x:Class="Sluggity.Pages.LevelSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewModels="clr-namespace:Sluggity.ViewModels"
      Title="LevelSelectionPage">

    <Page.Resources>
        <Style x:Key="LevelCard" TargetType="Button">
            <Setter Property="Width" Value="230" />
            <Setter Property="Height" Value="250" />
            <Setter Property="Margin" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource SeaBackground}">
        <DockPanel Margin="40,30">
            <TextBlock DockPanel.Dock="Top" Text="Choose a level" FontSize="80" Style="{StaticResource TitleText}" />

            <Button DockPanel.Dock="Bottom" Content="Back" HorizontalAlignment="Left"
                    Style="{StaticResource SmallMenuButton}" Click="BackButton_Click" />

            <ItemsControl x:Name="LevelList" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:LevelCardViewModel}">
                        <Button Style="{StaticResource LevelCard}" IsEnabled="{Binding IsUnlocked}"
                                Click="LevelCard_Click">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Number}" FontSize="96" Style="{StaticResource TitleText}" />
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="22"
                                           Style="{StaticResource BodyText}" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Image Source="/Sprites/pearl.png" Width="30" Height="24" Margin="0,0,8,0" />
                                    <TextBlock x:Name="Status" Text="{Binding PearlsText}"
                                               Style="{StaticResource BodyText}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                <Setter TargetName="Status" Property="Text" Value="locked" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Status" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Grid>
</Page>
